{
  "name": "spatiotemporal-iot-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "node scripts/test-backend.mjs",
    "test:backend:unit": "node scripts/test-backend.mjs --unit",
    "test:e2e": "playwright test",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:all": "npm run test:types && npm run build && npm run test:coverage && npm run test:backend && npm run test:e2e && python3 scripts/check-docs-drift.py"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "5.0.5"
  }
}
