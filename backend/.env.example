# Copy to .env, replace every secret, never commit .env.
IOT_DATABASE_URL=postgresql+asyncpg://YOUR_USER@127.0.0.1:5432/iot_platform
IOT_TIMEZONE=Asia/Shanghai

# Auth
IOT_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
IOT_JWT_ISSUER=pingan-iot
IOT_ACCESS_TOKEN_MINUTES=480
IOT_WS_TICKET_SECONDS=60
IOT_ADMIN_USERNAME=admin
IOT_ADMIN_PASSWORD=REPLACE_ME
IOT_OPERATOR_USERNAME=operator
IOT_OPERATOR_PASSWORD=REPLACE_ME
IOT_VIEWER_USERNAME=viewer
IOT_VIEWER_PASSWORD=REPLACE_ME

# One-click role login for the demo login page. Passwords never reach the
# browser; disable this outside local demos.
IOT_DEMO_LOGIN_ENABLED=true

# MQTT over TLS (localhost CA)
IOT_MQTT_ENABLED=true
IOT_MQTT_HOST=127.0.0.1
IOT_MQTT_PORT=8883
IOT_MQTT_TLS=true
IOT_MQTT_CA_CERTS=/absolute/path/to/backend/certs/rootCA.pem
IOT_MQTT_TLS_INSECURE=false
IOT_MQTT_USERNAME=iot_backend
IOT_MQTT_PASSWORD=REPLACE_ME
IOT_MQTT_TOPIC_PREFIX=iot/pingan

# Data source: true = built-in simulator; false = ingest-only mode for real devices
IOT_SIMULATION_ENABLED=true

# HTTPS
IOT_TLS_ENABLED=true
IOT_API_PORT=8443

# ── 大模型通道（可选的增强；留空或关闭时 Copilot 走前端规则引擎）──
# IOT_LLM_ENABLED=true 才会向云端发请求。
IOT_LLM_ENABLED=false
IOT_LLM_BASE_URL=https://api.deepseek.com/v1
IOT_LLM_API_KEY=
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，当前模型名如下
IOT_LLM_MODEL_CHAT=deepseek-flash
IOT_LLM_MODEL_REASON=deepseek-v4-pro
IOT_LLM_TIMEOUT_SECONDS=20
# 关掉思考后单次约 150 token；给小了会被 reasoning token 吃光并返回空正文
IOT_LLM_MAX_TOKENS=220

# 向量通道（当前未启用：56 实体 / 126 关系 + 23 篇文档的规模用不上向量库）
IOT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
IOT_EMBEDDING_API_KEY=
IOT_EMBEDDING_MODEL=BAAI/bge-m3
